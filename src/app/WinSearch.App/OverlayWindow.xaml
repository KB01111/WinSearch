<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinSearch.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Border
            x:Name="Panel"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowSpacing="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search header -->
                <Grid Grid.Row="0" Height="64" Padding="16,0,12,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE721;" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        KeyDown="OnSearchBoxKeyDown"
                        PlaceholderText="Search apps, files, and content" />

                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="6,2">
                        <TextBlock
                            x:Name="ModeIndicator"
                            FontSize="11"
                            Foreground="White"
                            Text="All" />
                    </Border>
                </Grid>

                <!-- Results (virtualized) -->
                <ListView
                    x:Name="ResultsList"
                    Grid.Row="1"
                    MaxHeight="384"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="OnResultClick"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56" Padding="8,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{Binding IconGlyph}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxWidth="360" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Explanation}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding LocationLabel}"
                                        HorizontalAlignment="Right" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding KindLabel}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Status + keyboard hints -->
                <Grid Grid.Row="2" Height="32" Padding="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="↑↓ navigate · Enter open · Space preview · Ctrl+Enter reveal · Esc close" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
